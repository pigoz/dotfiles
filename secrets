#!/bin/zsh
# Secrets that can't live in this public repo, kept in Bitwarden as secure
# notes (one per file) in the "dotfiles" folder.
#
#   secrets push       upload the local files that changed
#   secrets pull [-f]  write the files from Bitwarden (-f overwrites local changes)
#   secrets verify     compare Bitwarden with the local files
#   secrets status     offline: tell if local files changed since last push/pull
#   secrets session    unlock and print BW_SESSION, to reuse it across calls
setopt err_exit no_unset pipe_fail

# paths relative to ~; the dev/ ones are files ignored by git in my repos
files=(
  .ssh/id_rsa
  .ssh/id_rsa.pub
  .ssh/id_superagent
  .ssh/id_superagent.pub
  .config/sops/age/keys.txt
  .localrc
  dev/gromia-backend/.env.production
  dev/gromia-backend/config/master.key
  dev/superagent/config/master.key
  dev/superagent/.devcontainer/.env.imgproxy
  .claude/settings.json
  dev/superagent/.claude/settings.local.json
)
folder=dotfiles
server=https://vault.bitwarden.eu
state=$HOME/.local/state/dotfiles-secrets

# bw comes from mise, which may not be activated yet (e.g. during bootstrap)
(( $+commands[bw] )) || path=($HOME/.local/share/mise/shims $path)

checksums() {
  local f
  for f in $files; do
    [[ -f $HOME/$f ]] && print -r -- "$(md5 -q $HOME/$f) $f"
  done
  return 0
}

save_state() {
  mkdir -p ${state:h}
  checksums > $state
}

unlock() {
  [[ -n ${BW_SESSION:-} ]] && return
  if bw login --check > /dev/null 2>&1; then
    BW_SESSION=$(bw unlock --raw)
  else
    bw config server $server > /dev/null
    BW_SESSION=$(bw login --raw)
  fi
  export BW_SESSION
}

# every bw call starts a packaged node app (~0.6s), so keep them to a minimum
load() {
  unlock
  bw sync > /dev/null
  fid=$(bw list folders | jq -r --arg n $folder 'map(select(.name == $n))[0].id // empty')
  if [[ -z $fid ]]; then
    fid=$(jq -n --arg n $folder '{name: $n}' | base64 | bw create folder | jq -r .id)
  fi
  items=$(bw list items --folderid $fid)
}

item_id() { jq -r --arg n "~/$1" 'map(select(.name == $n))[0].id // empty' <<< $items }

# Bitwarden caps an encrypted note at 10000 chars, so bigger files are gzipped
big=5000
gz=gzip-base64:

note() {
  local n="~/$1"
  if jq -e --arg n $n --arg p $gz 'map(select(.name == $n))[0].notes // "" | startswith($p)' <<< $items > /dev/null; then
    jq -j --arg n $n --arg p $gz 'map(select(.name == $n))[0].notes | ltrimstr($p)' <<< $items | base64 -d | gunzip
  else
    jq -j --arg n $n 'map(select(.name == $n))[0].notes // empty' <<< $items
  fi
}

# what goes in the note for a local file
content() {
  if (( $(wc -c < $HOME/$1) > big )); then
    print -rn -- $gz$(gzip -9cn $HOME/$1 | base64)
  else
    cat $HOME/$1
  fi
}

cmd_push() {
  load
  local f id
  for f in $files; do
    if [[ ! -f $HOME/$f ]]; then
      print "missing  ~/$f"
      continue
    fi
    id=$(item_id $f)
    if [[ -z $id ]]; then
      jq -n --arg n "~/$f" --arg fid $fid --rawfile c <(content $f) \
        '{type: 2, secureNote: {type: 0}, name: $n, notes: $c, folderId: $fid}' \
        | base64 | bw create item > /dev/null
      print "added    ~/$f"
    elif [[ $(note $f | md5 -q) != $(md5 -q $HOME/$f) ]]; then
      jq --arg id $id --rawfile c <(content $f) 'map(select(.id == $id))[0] | .notes = $c' <<< $items \
        | base64 | bw edit item $id > /dev/null
      print "updated  ~/$f"
    fi
  done
  save_state
}

cmd_pull() {
  load
  local f dest
  for f in $files; do
    dest=$HOME/$f
    if [[ -z $(item_id $f) ]]; then
      print "not in Bitwarden  ~/$f"
      continue
    fi
    # writing into a repo that isn't cloned yet would make `git clone` fail
    if [[ $f == dev/* && ! -d $HOME/dev/${${f#dev/}%%/*} ]]; then
      print "not cloned, skipped  ~/$f"
      continue
    fi
    if [[ -f $dest && $(note $f | md5 -q) == $(md5 -q $dest) ]]; then
      continue
    fi
    if [[ -f $dest && ${1:-} != -f ]]; then
      print "local changes, skipped  ~/$f (pull -f to overwrite)"
      continue
    fi
    mkdir -p -m 700 ${dest:h}
    note $f > $dest
    if [[ $f == *.pub ]]; then chmod 644 $dest; else chmod 600 $dest; fi
    print "wrote    ~/$f"
  done
  save_state
}

cmd_verify() {
  load
  local f bad=0
  for f in $files; do
    if [[ $(note $f | md5 -q) == $(md5 -q $HOME/$f 2> /dev/null) ]]; then
      print "ok       ~/$f"
    else
      print "DIFFERS  ~/$f"
      bad=1
    fi
  done
  return $bad
}

cmd_status() {
  if [[ ! -f $state ]]; then
    print "secrets: not in Bitwarden yet, run \`secrets push\`"
    return 1
  fi
  local changed
  changed=$({ checksums | diff - $state || true } | sed -nE 's|^[<>] [0-9a-f]+ |~/|p' | sort -u | tr '\n' ' ')
  if [[ -n $changed ]]; then
    print "secrets: ${changed}changed, run \`secrets push\`"
    return 1
  fi
}

case ${1:-} in
  push) cmd_push ;;
  pull) cmd_pull ${2:-} ;;
  verify) cmd_verify ;;
  status) cmd_status ;;
  session) unlock; print -r -- $BW_SESSION ;;
  *) print -u2 "usage: secrets push | pull [-f] | verify | status | session"; exit 2 ;;
esac
