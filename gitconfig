# vim: syntax=gitconfig

[user]
  name = Stefano Pigozzi
  email = stefano.pigozzi@gmail.com
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[core]
  excludesfile = ~/.gitignore
  editor = nvim
[alias]
  st = status
  co = checkout
  cad = commit --amend --date=now
  ff = merge --ff-only
[pull]
  rebase = true
[init]
	defaultBranch = main
